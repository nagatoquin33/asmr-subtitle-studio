{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASMR字幕工作室",
  "version": "2.2.0",
  "identifier": "local.asmr.studio",
  "build": {
    "frontendDist": "../../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ASMR 字幕工作室",
        "label": "main",
        "create": false,
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 700,
        "backgroundColor": "#0d0f14",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://asmrmedia.localhost; media-src 'self' http://asmrmedia.localhost blob:; connect-src ipc: http://ipc.localhost http://asmrmedia.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"]
  }
}
